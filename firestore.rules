rules_version = '2';
// Black Tap Bar Book: Firestore security rules, version 3 (staff app, 15 November 2026).
//
// Everyone joins the same way, and a senior unlocks more with their own code (16 November 2026):
// - Every phone signs in anonymously (Firebase gives it an id, nothing is typed) and joins with the team code, which
//   arrives inside the team link shared in the staff WhatsApp group: staff/{uid} = {name, role: 'staff', code, at},
//   where code must equal config/team.code. Only the Firebase console can read or change config/team; changing the code
//   there takes every phone off the team at once (seniors included), and they join again with the new link.
// - Up to three seniors (role 'manager'). The owner adds each one by name with their own 4 digit code: seniors/{id} =
//   {name, tries, lastTry} for the team to pick from, and pins/{id} = {salt, hash}, which only the owner can read. A
//   senior unlocks on any joined phone by picking their name and typing their code. Guesses are counted by the server:
//   each one is first saved to unlocks/{uid} together with a +1 on that senior's tries (5 free, then one every 15
//   minutes, then none after 10 until the owner resets it), and only then checked against the hash. A right code turns
//   the phone's record into staff/{uid} = {name, role: 'manager', code, at, pin} and sets tries back to 0. Taking the
//   senior off (deleting seniors/{id}) takes every phone they unlocked back to staff powers at once.
// - The owner signs in with a username and password (made at first-time setup, 25 October 2026):
//   staff/{uid} = {name, username, role: 'owner'}, with usernames/{username} pointing the login screen at it.
//
// Team only: rate the shift is copied to sent/ with no uid and no name when it's sent, like everything sent from the
// app. Anything written here can be read by the seniors and the owner, except Tell Derek (tells/), which only the
// owner reads.
//
// Anything not matched below is denied, including every collection that isn't listed.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is asking ----------
    function signedIn() { return request.auth != null; }
    function staffDoc(uid) { return /databases/$(database)/documents/staff/$(uid); }
    function nameDoc(username) { return /databases/$(database)/documents/usernames/$(username); }
    function teamCode() { return get(/databases/$(database)/documents/config/team).data.code; }
    // The caller's staff record, or null when they haven't joined.
    function profile() { return get(staffDoc(request.auth.uid)); }
    function seniorDoc(id) { return /databases/$(database)/documents/seniors/$(id); }
    function pinDoc(id) { return /databases/$(database)/documents/pins/$(id); }
    function unlockDoc(uid) { return /databases/$(database)/documents/unlocks/$(uid); }
    // On the team: the owner, or a phone that joined with the team code that is current now.
    function isMember() {
      return signedIn() && profile() != null && (profile().data.role == 'owner' || profile().data.code == teamCode());
    }
    // The owner, or a phone unlocked with a senior's code while that senior is still on the team. Old password logins for
    // seniors (before 16 November 2026) hold no team code, so they no longer count.
    function isManager() {
      return isMember() && (profile().data.role == 'owner' || (profile().data.role == 'manager' && exists(seniorDoc(profile().data.get('pin', '-')))));
    }
    function isOwner() { return isMember() && profile().data.role == 'owner'; }

    // ---------- Field checks ----------
    function incoming() { return request.resource.data; }
    function exactly(keys) { return incoming().keys().hasAll(keys) && incoming().keys().hasOnly(keys); }
    function changesOnly(keys) { return incoming().diff(resource.data).affectedKeys().hasOnly(keys); }
    // Required text needs something besides spaces. Optional text may be empty.
    function reqText(s, max) { return s is string && s.trim().size() > 0 && s.size() <= max; }
    function optText(s, max) { return s is string && s.size() <= max; }
    // timestamp.date() refuses impossible dates such as 2026-02-31, so this also checks the date is real.
    function dayOf(s) { return timestamp.date(int(s[0:4]), int(s[5:7]), int(s[8:10])); }
    function isDay(s) { return s is string && s.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function isTime(s) { return s is string && s.matches('([01][0-9]|2[0-3]):[0-5][0-9]'); }
    // Written by the caller: their uid, their name as it is on their staff record, and the server's clock.
    function stamped() {
      return incoming().uid == request.auth.uid && incoming().name == profile().data.name && incoming().at == request.time;
    }
    // The same for a change, under that change's own field names.
    function signedAs(nameKey, uidKey, atKey) {
      return incoming()[nameKey] == profile().data.name && incoming()[uidKey] == request.auth.uid && incoming()[atKey] == request.time;
    }
    // Lower case, with every run of other characters turned into one dash. The app does exactly the same.
    function slug(s) { return s.lower().replace('[^a-z0-9]+', '-'); }
    function autoId(s) { return s is string && s.matches('[A-Za-z0-9]{20}'); }

    // ---------- Joining the team ----------
    // config/team {code} is made by hand in the Firebase console. No phone can read it; the rules compare against it.
    match /config/{id} {
      allow read, write: if false;
    }
    // A phone joins with the team code and a first name. It can change its own name (a shared bar phone passed to the
    // next person), lock itself back to staff powers, and leave. Everyone on the team can see who has joined. A senior or
    // the owner can take a staff phone off the team (lost, or someone who has left); only the owner takes off a phone a
    // senior unlocked. Nobody can change or remove the owner's record.
    function validJoin(uid) {
      return exactly(['name', 'role', 'code', 'at']) && reqText(incoming().name, 30) && incoming().role == 'staff'
        && incoming().code is string && incoming().code.size() >= 8 && incoming().code == teamCode()
        && incoming().at == request.time && request.auth.uid == uid;
    }
    // A joined phone becomes a senior's: the guess was already saved and counted (unlocks/{uid}, see pins below), it is
    // the latest guess at that senior's code, and it matches. get() reads the guess as it was saved, before this write.
    function validUnlock(uid) {
      let u = get(unlockDoc(uid)).data;
      let p = get(pinDoc(u.id)).data;
      return request.auth.uid == uid && resource.data.role == 'staff' && resource.data.code == teamCode()
        && exactly(['name', 'role', 'code', 'at', 'pin']) && incoming().role == 'manager' && incoming().pin == u.id
        && incoming().code == resource.data.code && incoming().at == request.time && incoming().name == get(seniorDoc(u.id)).data.name
        && u.n == get(seniorDoc(u.id)).data.tries && hashing.sha256(u.guess + ':' + p.salt).toHexString().lower() == p.hash;
    }
    match /staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isMember();
      allow create: if validJoin(uid);
      allow update: if (validJoin(uid) && resource.data.role in ['staff', 'manager']) || validUnlock(uid);
      allow delete: if resource.data.role != 'owner'
        && ((signedIn() && request.auth.uid == uid) || (resource.data.role == 'staff' && isManager()) || isOwner());
    }
    // The login screen looks up the owner's username before signing in, so a single lookup is public. Listing them is
    // not. A record holds the account's made-up sign-in address (never a real email) and its uid. The owner can delete the
    // old senior logins from before 16 November 2026.
    match /usernames/{username} {
      allow get: if true;
      allow delete: if isOwner() && get(staffDoc(resource.data.uid)).data.role != 'owner';
    }

    // ---------- Seniors and their codes ----------
    // seniors/{id} = {name, tries, lastTry}: the names the team picks from on "Unlock as a senior", with how many wrong
    // guesses there have been since the last right one, so the phone can say when it can try again. Each senior's code is
    // in pins/{id} = {salt, hash} as a salted SHA-256 hash. Nobody but the owner can read pins, so the 10,000 possible codes
    // can't be tried on a phone: every guess goes through the server and is counted here first. 5 guesses since the last
    // right one are free, then one every 15 minutes, then none after 10 until the owner sets the count back to 0 (or gives
    // a new code).
    function seniorSet() {
      return isOwner() && exactly(['name', 'tries', 'lastTry']) && reqText(incoming().name, 30)
        && incoming().tries == 0 && incoming().lastTry == request.time;
    }
    function guessCounted(id) {
      let t = resource.data.tries;
      return isMember() && changesOnly(['tries', 'lastTry']) && incoming().tries == t + 1 && incoming().lastTry == request.time
        && (t < 5 || (t < 10 && request.time > resource.data.lastTry + duration.value(15, 'm')))
        && getAfter(unlockDoc(request.auth.uid)).data.id == id;
    }
    // A right code sets the count back to 0, in the same write as the phone becoming the senior's.
    function rightCode(id) {
      return isMember() && profile().data.role == 'staff' && changesOnly(['tries', 'lastTry']) && incoming().tries == 0 && incoming().lastTry == request.time
        && getAfter(staffDoc(request.auth.uid)).data.role == 'manager' && getAfter(staffDoc(request.auth.uid)).data.pin == id;
    }
    match /seniors/{id} {
      allow read: if isMember();
      allow create: if seniorSet() && id.matches('[a-z0-9-]{1,30}') && existsAfter(pinDoc(id));
      allow update: if seniorSet() || guessCounted(id) || rightCode(id);
      allow delete: if isOwner() && !existsAfter(pinDoc(id));
    }
    match /pins/{id} {
      allow read: if isOwner();
      allow create, update: if isOwner() && exactly(['salt', 'hash']) && incoming().salt is string && incoming().salt.matches('[0-9a-f]{32}')
        && incoming().hash is string && incoming().hash.matches('[0-9a-f]{64}') && existsAfter(seniorDoc(id));
      allow delete: if isOwner() && !existsAfter(seniorDoc(id));
    }
    // A phone's latest guess, saved with its number so the check above knows it was counted. Nobody reads it back.
    match /unlocks/{uid} {
      allow create, update: if isMember() && request.auth.uid == uid && exactly(['id', 'guess', 'n', 'at'])
        && incoming().id is string && incoming().guess is string && incoming().guess.matches('[0-9]{4}') && incoming().n is int
        && incoming().n > 0 && incoming().at == request.time && getAfter(seniorDoc(incoming().id)).data.tries == incoming().n
        && getAfter(seniorDoc(incoming().id)).data.lastTry == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // No messaging inside the app (15 November 2026): the team talks face to face and sends on WhatsApp.

    // ---------- To the manager ----------
    // Days off, swaps, complaints, faults, things to fix, ideas, incidents or anything else, sent to the manager only. An anonymous one
    // holds no name and no device id, so the manager can't tell who sent it from the record (in a small team they may
    // still guess, and the app says so). Staff can read back their own named ones. The manager reads all of them and
    // marks each one seen, or done with a reply.
    function validAsk() {
      let a = incoming();
      return a.kind in ['dayoff', 'swap', 'complaint', 'fault', 'fix', 'idea', 'incident', 'other'] && reqText(a.text, 2000)
        && optText(a.when, 60) && a.status == 'new' && a.at == request.time
        && ((a.anon == true && exactly(['kind', 'text', 'when', 'anon', 'status', 'at']))
          || (a.anon == false && exactly(['kind', 'text', 'when', 'anon', 'status', 'uid', 'name', 'at']) && stamped()));
    }
    match /asks/{id} {
      allow read: if isManager() || (isMember() && resource.data.get('uid', '') == request.auth.uid);
      allow create: if isMember() && validAsk();
      allow update: if isManager() && changesOnly(['status', 'reply', 'by', 'byAt'])
        && incoming().status in ['seen', 'done'] && optText(incoming().reply, 500)
        && incoming().by == profile().data.name && incoming().byAt == request.time;
      allow delete: if isManager();
    }

    // ---------- Tell Derek ----------
    // Anyone on the team tells the owner what's missing, what to add or what's wrong. Only the owner reads them all;
    // each person reads back their own. The owner marks one done or removes it.
    match /tells/{id} {
      allow read: if isOwner() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if isMember() && exactly(['kind', 'text', 'status', 'uid', 'name', 'at'])
        && incoming().kind in ['missing', 'add', 'wrong'] && reqText(incoming().text, 1000) && incoming().status == 'new' && stamped();
      allow update: if isOwner() && changesOnly(['status']) && incoming().status == 'done';
      allow delete: if isOwner();
    }

    // ---------- A copy of everything sent ----------
    // Each message sent from the Send page (WhatsApp, email, share sheet, print) is copied here for the seniors and
    // the owner. Team only: rate the shift ('rate') goes with no uid and no name; My pay ('hours', 'pay') and the team link ('team') are never copied.
    match /sent/{id} {
      allow read: if isManager();
      allow create: if isMember() && incoming().k is string && incoming().k.size() > 0 && incoming().k.size() <= 20
        && !(incoming().k in ['hours', 'pay', 'team']) && reqText(incoming().what, 100) && reqText(incoming().text, 8000)
        && ((incoming().k == 'rate' && exactly(['k', 'what', 'text', 'anon', 'at']) && incoming().anon == true && incoming().at == request.time)
          || (incoming().k != 'rate' && exactly(['k', 'what', 'text', 'uid', 'name', 'at']) && stamped()));
      allow delete: if isOwner();
    }

    // ---------- Shift reports and closing photos ----------
    // A report is sent once, with its photos attached in the same write. Nobody can edit or delete one from the app.
    match /reports/{id} {
      allow read: if isMember();
      allow create: if isMember() && exactly(['side', 'text', 'summary', 'photos', 'uid', 'name', 'at'])
        && incoming().side in ['bar', 'floor']
        && reqText(incoming().text, 8000) && reqText(incoming().summary, 200)
        && incoming().photos is int && incoming().photos >= 0 && incoming().photos <= 8
        && stamped();
    }
    function reportDoc(id) { return /databases/$(database)/documents/reports/$(id); }
    match /photos/{id} {
      // Tonight's unsent closing photos are shared by everyone on the team, so phones closing one side together see
      // the same ones, and photos on a sent report stay readable with it.
      allow read: if isMember();
      allow create: if isMember() && exactly(['data', 'note', 'report', 'side', 'uid', 'name', 'at'])
        && incoming().data is string && incoming().data.size() <= 700000
        && incoming().data.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
        && incoming().side in ['bar', 'floor'] && incoming().note == '' && incoming().report == null && stamped();
      // Until it's sent, anyone on the team can change the note. It is attached only inside the write that creates the
      // report for its side (the report's time is this request's time), so it can't move onto an older report.
      allow update: if isMember() && resource.data.report == null
        && ((changesOnly(['note']) && optText(incoming().note, 300))
          || (changesOnly(['report']) && autoId(incoming().report)
              && getAfter(reportDoc(incoming().report)).data.uid == request.auth.uid
              && getAfter(reportDoc(incoming().report)).data.at == request.time
              && getAfter(reportDoc(incoming().report)).data.side == resource.data.get('side', getAfter(reportDoc(incoming().report)).data.side)));
      // Unsent ones can be binned by anyone on the team. The owner's or a senior's phone clears photos over 30 days old (to stay free).
      allow delete: if isMember() && (resource.data.report == null
        || (isManager() && resource.data.at < request.time - duration.value(30, 'd')));
    }

    // ---------- Tonight's handover draft ----------
    // One per side for the business day ({day}-{side}), shared live by everyone closing that side until it's sent.
    match /drafts/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && exactly(['day', 'side', 'low', 'issues', 'next', 'closer', 'noPhotos', 'uid', 'name', 'at'])
        && incoming().side in ['bar', 'floor'] && isDay(incoming().day) && id == incoming().day + '-' + incoming().side
        && dayOf(incoming().day) > request.time - duration.value(2, 'd') && dayOf(incoming().day) < request.time + duration.value(1, 'd')
        && optText(incoming().low, 2000) && optText(incoming().issues, 2000) && optText(incoming().next, 2000)
        && optText(incoming().closer, 300) && optText(incoming().noPhotos, 300) && stamped();
      allow delete: if isMember();
    }

    // ---------- Tonight's checklists: tasks and procedures ----------
    // {day} is the business day (YYYY-MM-DD, rolling over at 6am UK time). Writes are only accepted within a day or two
    // of it, which allows for a phone that was offline and syncs late.
    function nearNow(day) {
      return isDay(day) && dayOf(day) > request.time - duration.value(2, 'd') && dayOf(day) < request.time + duration.value(1, 'd');
    }
    // Each list is a procedure: the bar's opening and closing, and the floor's tables, milkshake station and close.
    function isList(l) { return l in ['open', 'close', 'fset', 'fshake', 'fclose']; }
    function sideOf(l) { return l in ['open', 'close'] ? 'bar' : 'floor'; }
    function taskDoc(day, id) { return /databases/$(database)/documents/shift/$(day)/tasks/$(id); }
    function runDoc(day, list) { return /databases/$(database)/documents/shift/$(day)/runs/$(list); }
    function eventDoc(id) { return /databases/$(database)/documents/events/$(id); }
    // A field as it was before this write, or d for a new record.
    function was(k, d) { return resource == null ? d : resource.data[k]; }
    // Someone on the team, named as on their staff record, or nobody (both null).
    function teammate(name, uid) { return (name == null && uid == null) || (uid is string && get(staffDoc(uid)).data.name == name); }
    // A procedure is locked once it's finished, until someone reopens it with a reason.
    function unlocked(day, list) { let r = get(runDoc(day, list)); return r == null || r.data.status != 'finished'; }

    // Ticks from before tasks (24 and 25 October 2026), kept for the record. Nothing new is written.
    match /shift/{day}/ticks/{id} {
      allow read: if isMember();
    }

    // One record per item per night: todo (not started), doing, done, blocked or cancelled (not needed tonight). item is
    // the item's id in its list. Each
    // change raises v by one and writes events/t-{day}-{list}-{item}-{v} in the same batch, so a change can't happen
    // without its event, an event can't be made up, and a phone working from an old copy (two people at once, or a late
    // sync) is refused instead of overwriting the newer change. Nobody deletes a task.
    match /shift/{day}/tasks/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && nearNow(day) && stamped() && validTask(day, id)
        && existsAfter(eventDoc('t-' + day + '-' + id + '-' + string(incoming().v)));
    }
    function validTask(day, id) {
      let t = incoming();
      let from = was('status', 'todo');
      return exactly(['list', 'item', 'status', 'who', 'whoUid', 'note', 'v', 'uid', 'name', 'at'])
        && isList(t.list) && t.item is int && t.item >= 0 && t.item < 1000 && id == t.list + '-' + string(t.item)
        && t.v == was('v', 0) + 1 && optText(t.note, 200) && unlocked(day, t.list)
        && ((t.status == from && givenTo(t, from))
          || (t.status != from && t.who == was('who', null) && t.whoUid == was('whoUid', null) && taskMove(from, t.status, t.note)));
    }
    // The manager gives a task to someone, or takes it off them, without changing where it's up to.
    function givenTo(t, from) {
      return isManager() && from in ['todo', 'doing', 'blocked'] && t.whoUid != was('whoUid', null) && teammate(t.who, t.whoUid);
    }
    // Where a task can go from where it is. Blocked and Not needed need a reason, and only managers mark a task not
    // needed. Anyone on the team can take a task back to not started (a mis-tap, or clearing a list to start again):
    // the event still says who and when.
    function taskMove(from, to, note) {
      return (to == 'doing' && from in ['todo', 'blocked'])
        || (to == 'done' && from in ['todo', 'doing', 'blocked'])
        || (to == 'blocked' && from in ['todo', 'doing'] && reqText(note, 200))
        || (to == 'cancelled' && from in ['todo', 'doing', 'blocked'] && isManager() && reqText(note, 200))
        || (to == 'todo' && from in ['blocked', 'doing', 'done'])
        || (to == 'todo' && from == 'cancelled' && isManager());
    }

    // One record per list per night: started, then finished. Finishing with tasks left needs a manager and a reason
    // (an override). Anyone can reopen a finished list, with a reason (Cleared, when a list is cleared). done and required are counted by the phone that finishes it: the rules
    // can't count the tasks, so the tasks and their events stay the record of what was done.
    match /shift/{day}/runs/{list} {
      allow read: if isMember();
      allow create, update: if isMember() && nearNow(day) && stamped() && validRun(list)
        && existsAfter(eventDoc('r-' + day + '-' + list + '-' + string(incoming().v)));
    }
    function validRun(list) {
      let r = incoming();
      let from = was('status', 'todo');
      return exactly(['list', 'status', 'done', 'required', 'note', 'v', 'uid', 'name', 'at'])
        && r.list == list && isList(list) && r.v == was('v', 0) + 1 && optText(r.note, 300)
        && r.done is int && r.required is int && r.done >= 0 && r.done <= r.required && r.required <= 60
        && ((r.status == 'started' && from == 'todo')
          || (r.status == 'finished' && from in ['todo', 'started'] && (r.done == r.required || (isManager() && reqText(r.note, 300))))
          || (r.status == 'started' && from == 'finished' && reqText(r.note, 300)));
    }

    // ---------- The lists themselves ----------
    // Every list starts as the standard version written into the app. The manager changes it in the app (rewords, adds,
    // moves or removes items, or picks the days one shows) by saving the whole list as lists/{key}, which then takes the
    // standard one's place on every phone. Each save raises v by one and writes a copy to listlog/{key}-{v} in the same
    // batch, so every version is kept with who saved it and when, and putting an old one back is a new version. Each
    // item is {id, t, days}: the id stays with the item, so tonight's tasks stay on the right one, and next is the id
    // the next new item gets, which never goes down, so no id is used for two items. The rules can't look inside a
    // list, so the app checks each item when it reads them. Lists can't be deleted, and the history can't be changed.
    function listDoc(k) { return /databases/$(database)/documents/lists/$(k); }
    match /lists/{key} {
      allow read: if isMember();
      allow create, update: if isManager() && isList(key) && stamped() && exactly(['items', 'next', 'v', 'uid', 'name', 'at'])
        && incoming().items is list && incoming().items.size() > 0 && incoming().items.size() <= 60
        && incoming().next is int && incoming().next >= was('next', 0) && incoming().next <= 1000
        && incoming().v == was('v', 0) + 1
        && existsAfter(/databases/$(database)/documents/listlog/$(key + '-' + string(incoming().v)));
    }
    match /listlog/{id} {
      allow read: if isManager();
      allow create: if isManager() && stamped() && exactly(['list', 'items', 'next', 'v', 'uid', 'name', 'at'])
        && isList(incoming().list) && incoming().v is int && id == incoming().list + '-' + string(incoming().v)
        && getAfter(listDoc(incoming().list)).data.v == incoming().v
        && getAfter(listDoc(incoming().list)).data.items == incoming().items
        && getAfter(listDoc(incoming().list)).data.next == incoming().next
        && getAfter(listDoc(incoming().list)).data.at == request.time;
    }

    // ---------- Date labels for open items ----------
    // One record per thing a side dates once it's opened (a juice, a sauce, a cake): what it is, its side, how many days
    // it keeps once opened, whether it needs a label (on), and where it's up to. The manager adds, changes and removes them.
    // Anyone on the team opens one (today, with the use-by date its life gives it, or an earlier one when the pack's own
    // date comes first), changes one (the old one binned and a new one opened and labelled) or bins one (used up or
    // thrown away, with no new one opened). Each change raises v and writes events/l-{id}-{v} in the same batch, so every
    // label has a record of who did what and when, and a phone working from an old copy is refused.
    function labelDoc(id) { return /databases/$(database)/documents/labels/$(id); }
    match /labels/{id} {
      allow read: if isMember();
      allow create: if isManager() && autoId(id) && stamped() && validLabel() && incoming().v == 1 && incoming().act == 'added'
        && notOpen(incoming()) && existsAfter(eventDoc('l-' + id + '-1'));
      allow update: if isMember() && stamped() && validLabel() && incoming().v == resource.data.v + 1 && labelMove()
        && existsAfter(eventDoc('l-' + id + '-' + string(incoming().v)));
      allow delete: if isManager() && existsAfter(eventDoc('l-' + id + '-' + string(resource.data.v + 1)));
    }
    function validLabel() {
      let l = incoming();
      return exactly(['item', 'side', 'life', 'on', 'state', 'openedOn', 'useBy', 'openedBy', 'openedUid', 'act', 'v', 'uid', 'name', 'at'])
        && reqText(l.item, 60) && l.side in ['bar', 'floor'] && l.life is int && l.life >= 1 && l.life <= 365 && l.on is bool;
    }
    function notOpen(l) { return l.state == 'none' && l.openedOn == null && l.useBy == null && l.openedBy == null && l.openedUid == null; }
    // Opened by the caller today, with a use-by date no later than its life allows.
    function openedNow(l) {
      return l.state == 'open' && nearNow(l.openedOn) && isDay(l.useBy)
        && dayOf(l.useBy) >= dayOf(l.openedOn) && dayOf(l.useBy) <= dayOf(l.openedOn) + duration.value(l.life, 'd')
        && l.openedBy == profile().data.name && l.openedUid == request.auth.uid;
    }
    function labelMove() {
      let l = incoming();
      let old = resource.data;
      let same = l.state == old.state && l.openedOn == old.openedOn && l.useBy == old.useBy && l.openedBy == old.openedBy && l.openedUid == old.openedUid;
      let def = l.item == old.item && l.side == old.side && l.life == old.life && l.on == old.on;
      return (l.act == 'edited' && isManager() && same && !def)
        || (l.act == 'opened' && def && old.state == 'none' && openedNow(l))
        || (l.act == 'changed' && def && old.state == 'open' && openedNow(l))
        || (l.act == 'binned' && def && old.state == 'open' && notOpen(l));
    }

    // ---------- Restocking from the cellar ----------
    // Someone asks for an item, an amount and where it's going, with any detail (which never changes). Someone takes it
    // on (or gives it to someone), brings it up saying how much they moved, and the bar or floor
    // confirms how much arrived. Asked, moved and received are kept apart, so a request is never taken as proof that the
    // stock arrived, and no stock level changes here. note is the reason for the latest change. Each change raises v and
    // writes events/s-{id}-{v} in the same batch, like tasks.
    function restockDoc(id) { return /databases/$(database)/documents/restock/$(id); }
    function amount(n) { return n is number && n > 0 && n <= 1000; }
    match /restock/{id} {
      allow read: if isMember();
      allow create: if isMember() && stamped() && autoId(id) && newRestock() && existsAfter(eventDoc('s-' + id + '-1'));
      allow update: if isMember() && stamped() && restockMove() && existsAfter(eventDoc('s-' + id + '-' + string(incoming().v)));
    }
    function newRestock() {
      let r = incoming();
      return exactly(['item', 'qty', 'unit', 'dest', 'detail', 'day', 'status', 'who', 'whoUid', 'moved', 'got', 'note', 'v', 'askedBy', 'askedUid', 'askedAt', 'uid', 'name', 'at'])
        && reqText(r.item, 80) && amount(r.qty) && r.unit in ['each', 'bottle', 'case', 'box', 'pack', 'bag', 'roll', 'keg', 'tub']
        && r.dest in ['up', 'down', 'shakes', 'floor'] && nearNow(r.day) && optText(r.detail, 200) && r.note == ''
        && r.status == 'asked' && r.who == null && r.whoUid == null && r.moved == null && r.got == null && r.v == 1
        && r.askedBy == profile().data.name && r.askedUid == request.auth.uid && r.askedAt == request.time;
    }
    function restockMove() {
      let r = incoming();
      let old = resource.data;
      let to = r.status;
      let from = old.status;
      let mine = old.whoUid == request.auth.uid;
      let me = r.whoUid == request.auth.uid && r.who == profile().data.name;
      let same = r.who == old.who && r.whoUid == old.whoUid && r.moved == old.moved && r.got == old.got;
      return r.diff(old).affectedKeys().hasOnly(['status', 'who', 'whoUid', 'moved', 'got', 'note', 'v', 'uid', 'name', 'at'])
        && r.v == old.v + 1 && optText(r.note, 200) && (
          // Given to someone, or to someone else, by a manager.
          (to == 'given' && from in ['asked', 'given', 'doing', 'blocked'] && isManager() && r.whoUid != null && r.whoUid != old.whoUid
            && teammate(r.who, r.whoUid) && r.moved == null && r.got == null)
          // Taken on by anyone while it's waiting; once it's been given to someone, by them or a manager.
          || (to == 'doing' && from in ['asked', 'given', 'blocked'] && me && (from != 'given' || mine || isManager()) && r.moved == null && r.got == null)
          // Brought up by whoever has it (or a manager), saying how much was moved.
          || (to == 'delivered' && from == 'doing' && (mine || isManager()) && r.who == old.who && r.whoUid == old.whoUid && amount(r.moved) && r.got == null)
          // Confirmed by whoever is there, saying how much arrived.
          || (to == 'received' && from == 'delivered' && r.who == old.who && r.whoUid == old.whoUid && r.moved == old.moved && amount(r.got))
          || (to == 'unavailable' && from in ['asked', 'given', 'doing', 'blocked'] && same)
          || (to == 'blocked' && from in ['asked', 'given', 'doing'] && same && reqText(r.note, 200))
          || (to == 'cancelled' && from in ['asked', 'given', 'doing', 'blocked'] && same
            && (old.askedUid == request.auth.uid || (isManager() && reqText(r.note, 200))))
          // Back to waiting: let go by whoever has it (or a manager), not there after all once brought up (with a
          // reason), or reopened by a manager (with a reason).
          || (to == 'asked' && r.who == null && r.whoUid == null && r.moved == null && r.got == null
            && ((from in ['given', 'doing'] && (mine || isManager()))
              || (from == 'delivered' && reqText(r.note, 200))
              || (from in ['received', 'unavailable', 'cancelled'] && isManager() && reqText(r.note, 200)))));
    }

    // ---------- Audit trail ----------
    // One event per change to a task, a procedure, a restock or a date label, written in the same batch
    // as the change and matching it (the status before and after, the version, who, the reason and the time; for a
    // restock, the item, amount and place; for a label, what was done and its dates). Nobody edits or deletes an event:
    // a correction is a new change with its own event. Ids carry the record's version, so a retried or repeated write
    // can't add a second event for the same change.
    match /events/{id} {
      allow read: if isMember();
      allow create: if isMember() && stamped() && nearNow(incoming().day) && reqText(incoming().label, 200) && optText(incoming().note, 300)
        && (incoming().kind == 'task' ? taskEvent(id) : incoming().kind == 'run' ? runEvent(id) : incoming().kind == 'restock' ? restockEvent(id)
          : incoming().kind == 'label' && labelEvent(id));
    }
    function taskEvent(id) {
      let e = incoming();
      let path = taskDoc(e.day, e.list + '-' + string(e.item));
      let now = getAfter(path).data;
      let before = get(path);
      return exactly(['kind', 'day', 'list', 'item', 'label', 'area', 'from', 'to', 'who', 'note', 'v', 'uid', 'name', 'at'])
        && e.item is int && id == 't-' + e.day + '-' + e.list + '-' + string(e.item) + '-' + string(e.v)
        && now.at == request.time && now.v == e.v && now.status == e.to && now.who == e.who && now.note == e.note
        && e.from == (before == null ? 'todo' : before.data.status) && e.area == sideOf(e.list);
    }
    function runEvent(id) {
      let e = incoming();
      let path = runDoc(e.day, e.list);
      let now = getAfter(path).data;
      let before = get(path);
      return exactly(['kind', 'day', 'list', 'label', 'area', 'from', 'to', 'done', 'required', 'note', 'v', 'uid', 'name', 'at'])
        && id == 'r-' + e.day + '-' + e.list + '-' + string(e.v)
        && now.at == request.time && now.v == e.v && now.status == e.to && now.note == e.note && now.done == e.done && now.required == e.required
        && e.from == (before == null ? 'todo' : before.data.status) && e.area == sideOf(e.list);
    }
    function restockEvent(id) {
      let e = incoming();
      let path = restockDoc(e.ref);
      let now = getAfter(path).data;
      let before = get(path);
      return exactly(['kind', 'day', 'ref', 'label', 'area', 'from', 'to', 'who', 'qty', 'unit', 'dest', 'note', 'v', 'uid', 'name', 'at'])
        && e.ref is string && id == 's-' + e.ref + '-' + string(e.v)
        && now.at == request.time && now.v == e.v && now.status == e.to && now.who == e.who && now.note == e.note
        && now.item == e.label && now.unit == e.unit && now.dest == e.dest
        && e.from == (before == null ? 'new' : before.data.status)
        && e.qty == (e.to == 'delivered' ? now.moved : e.to == 'received' ? now.got : e.from == 'new' ? now.qty : null)
        && e.area == (e.dest in ['up', 'down'] ? 'bar' : 'floor');
    }
    // act is what was done (added, edited, opened, changed, binned or removed). useBy is the label's date after the change
    // and was its date before, so a late change shows on the record. Opening and changing are recorded on the day the
    // label says it was opened.
    function labelEvent(id) {
      let e = incoming();
      let before = get(labelDoc(e.ref));
      let after = getAfter(labelDoc(e.ref));
      let l = after == null ? before.data : after.data;
      return exactly(['kind', 'day', 'ref', 'label', 'area', 'act', 'life', 'on', 'useBy', 'was', 'note', 'v', 'uid', 'name', 'at'])
        && autoId(e.ref) && id == 'l-' + e.ref + '-' + string(e.v) && e.note == ''
        && (after == null
          ? before != null && e.act == 'removed' && e.v == before.data.v + 1 && e.useBy == null
          : after.data.at == request.time && after.data.v == e.v && after.data.act == e.act && e.useBy == after.data.useBy
            && (!(e.act in ['opened', 'changed']) || e.day == after.data.openedOn))
        && e.was == (before == null ? null : before.data.useBy)
        && e.label == l.item && e.area == l.side && e.life == l.life && e.on == l.on;
    }

    // ---------- 86 board ----------
    // out/{item} is what's off tonight and outlog is its history. Each change writes both in one batch and the
    // rules check they match: an 86 creates out/{item} pointing at its new log entry; back in stock deletes it
    // and adds the entry {that log id}-back. So the board and its history can't drift apart, the same item
    // can't be 86'd twice, and nothing comes back that wasn't out. Anyone on the team 86s an item or brings it back.
    // Log entries can never be edited or deleted.
    function outDoc(item) { return /databases/$(database)/documents/out/$(item); }
    function logDoc(id) { return /databases/$(database)/documents/outlog/$(id); }
    match /out/{item} {
      allow read: if isMember();
      allow create: if isMember() && exactly(['itemName', 'log', 'uid', 'name', 'at'])
        && reqText(incoming().itemName, 80) && slug(incoming().itemName) == item && autoId(incoming().log)
        && getAfter(logDoc(incoming().log)).data.action == 'out' && getAfter(logDoc(incoming().log)).data.item == item
        && stamped();
      allow delete: if isMember() && existsAfter(logDoc(resource.data.log + '-back'));
    }
    match /outlog/{id} {
      allow read: if isMember();
      allow create: if isMember() && exactly(['item', 'itemName', 'action', 'uid', 'name', 'at']) && stamped()
        && reqText(incoming().itemName, 80) && incoming().item == slug(incoming().itemName)
        && ((incoming().action == 'out' && getAfter(outDoc(incoming().item)).data.log == id)
          || (incoming().action == 'back' && get(outDoc(incoming().item)).data.log + '-back' == id
              && getAfter(outDoc(incoming().item)) == null));
    }

    // ---------- Drink photos and how-to videos ----------
    // One record per drink, under the drink's name as the 86 board keys it. The owner or the manager adds the house photo (a JPEG,
    // like the closing photos) and a link to a how-to video on a video site, and everyone on the team sees them on the drink.
    // Only links to these sites are taken, so a record can't point anyone at a lookalike login page.
    function videoLink(s) {
      return s == '' || (s.size() <= 300
        && s.matches('https://(www[.]|m[.])?(youtube[.]com|youtu[.]be|vimeo[.]com|instagram[.]com|tiktok[.]com|drive[.]google[.]com)/[!-~]*'));
    }
    match /drinkMedia/{id} {
      allow read: if isMember();
      allow create, update: if isManager() && exactly(['drink', 'photo', 'video', 'uid', 'name', 'at']) && stamped()
        && reqText(incoming().drink, 80) && slug(incoming().drink) == id
        && incoming().photo is string && incoming().video is string
        && (incoming().photo == '' || (incoming().photo.size() <= 700000 && incoming().photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && videoLink(incoming().video) && (incoming().photo != '' || incoming().video != '');
      allow delete: if isManager();
    }

    // ---------- Who to call ----------
    // settings/contacts {list}: the venue's own numbers (the duty manager, maintenance, engineers), kept by the manager.
    match /settings/{id} {
      allow read: if isMember() && id == 'contacts';
      allow write: if isManager() && id == 'contacts' && exactly(['list', 'uid', 'name', 'at']) && incoming().list is list
        && incoming().list.size() <= 30 && stamped();
    }

    // ---------- Issues and handover ----------
    // Faults, jobs and anything the next shift needs to know. Open until someone fixes it, then kept as history.
    // A fixed issue can't be edited or reopened; "still broken" raises a new one that links back to it.
    match /issues/{id} {
      allow read: if isMember();
      allow create: if isMember() && exactly(['title', 'detail', 'area', 'urgent', 'again', 'status', 'uid', 'name', 'at'])
        && reqText(incoming().title, 120) && optText(incoming().detail, 1000)
        && incoming().area in ['bar', 'floor', 'toilets', 'terrace', 'cellar', 'other']
        && incoming().urgent is bool && incoming().status == 'open'
        && (incoming().again == null || (autoId(incoming().again) && exists(/databases/$(database)/documents/issues/$(incoming().again))))
        && stamped();
      // Take it on, or give it to someone on the team, or mark it fixed saying what was done.
      allow update: if isMember() && resource.data.status in ['open', 'taken']
        && ((incoming().status == 'taken' && changesOnly(['status', 'who', 'whoUid', 'setBy', 'setByUid', 'setAt'])
              && signedAs('setBy', 'setByUid', 'setAt') && incoming().whoUid is string
              && get(staffDoc(incoming().whoUid)).data.name == incoming().who)
          || (incoming().status == 'fixed' && changesOnly(['status', 'fix', 'fixedBy', 'fixedByUid', 'fixedAt'])
              && reqText(incoming().fix, 500) && signedAs('fixedBy', 'fixedByUid', 'fixedAt')));
      // Whoever raised it can withdraw it before anyone takes it on. The owner and the manager can take any one down.
      allow delete: if (isMember() && resource.data.uid == request.auth.uid && resource.data.status == 'open') || isManager();
    }

    // ---------- Football on the screens ----------
    // The owner or the manager lists the games the bar is showing: the day, kick-off, the teams, the competition, the channel and
    // the screen. Everyone on the team reads them. A wrong one is taken down and added again.
    match /fixtures/{id} {
      allow read: if isMember();
      allow create: if isManager() && exactly(['day', 'ko', 'home', 'away', 'comp', 'channel', 'screen', 'uid', 'name', 'at'])
        && isDay(incoming().day) && dayOf(incoming().day) > request.time - duration.value(2, 'd')
        && dayOf(incoming().day) < request.time + duration.value(90, 'd') && isTime(incoming().ko)
        && reqText(incoming().home, 40) && reqText(incoming().away, 40) && optText(incoming().comp, 40)
        && optText(incoming().channel, 30) && optText(incoming().screen, 30) && stamped();
      allow delete: if isManager();
    }

  }
}
